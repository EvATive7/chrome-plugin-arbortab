{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "146",
  "key": "",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-collapsed": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "__MSG_commandToggleCollapsed__"
    },
    "close-tree": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "__MSG_commandCloseTree__"
    },
    "outdent": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "__MSG_commandOutdent__"
    },
    "indent": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "__MSG_commandIndent__"
    }
  },
  "icons": {}
}
