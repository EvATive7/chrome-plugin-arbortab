{
  "manifest_version": 3,
  "name": "ArborTab",
  "version": "0.1.0",
  "description": "Tree-style tab management for the native vertical tab strip: collapsible subtrees, close-with-children, and drag-to-nest.",
  "minimum_chrome_version": "146",
  "key": "",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-collapsed": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Collapse or expand the current tab's subtree"
    },
    "close-tree": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Close the current tab and its whole subtree"
    },
    "outdent": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Promote the current tab one level"
    },
    "indent": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "Nest the current tab under the previous sibling"
    }
  },
  "icons": {}
}
