// Version resource of version.dll, generated from the repository's VERSION file.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ARBORTAB_VERSION_MAJOR@,@ARBORTAB_VERSION_MINOR@,@ARBORTAB_VERSION_PATCH@,0
 PRODUCTVERSION @ARBORTAB_VERSION_MAJOR@,@ARBORTAB_VERSION_MINOR@,@ARBORTAB_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ArborTab"
      VALUE "FileDescription", "ArborTab native module (version.dll proxy)"
      VALUE "FileVersion", "@ARBORTAB_VERSION@"
      VALUE "InternalName", "version"
      VALUE "OriginalFilename", "version.dll"
      VALUE "ProductName", "ArborTab"
      VALUE "ProductVersion", "@ARBORTAB_VERSION@"
      VALUE "LegalCopyright", "GPL-3.0-only"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
