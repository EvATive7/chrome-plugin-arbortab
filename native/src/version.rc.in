// Version resource of version.dll and arbortab-bridge.exe (native/CMakeLists.txt), generated from the repository's VERSION file.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ARBORTAB_VERSION_MAJOR@,@ARBORTAB_VERSION_MINOR@,@ARBORTAB_VERSION_PATCH@,0
 PRODUCTVERSION @ARBORTAB_VERSION_MAJOR@,@ARBORTAB_VERSION_MINOR@,@ARBORTAB_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @RC_FILETYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ArborTab"
      VALUE "FileDescription", "@RC_DESCRIPTION@"
      VALUE "FileVersion", "@ARBORTAB_VERSION@"
      VALUE "InternalName", "@RC_NAME@"
      VALUE "OriginalFilename", "@RC_FILENAME@"
      VALUE "ProductName", "ArborTab"
      VALUE "ProductVersion", "@ARBORTAB_VERSION@"
      VALUE "LegalCopyright", "GPL-3.0-only"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
